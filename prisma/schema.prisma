generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Operational infrastructure from Milestone 1.
model WorkerHeartbeat {
  instanceId String   @id @map("instance_id") @db.Uuid
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  version    String   @db.VarChar(64)

  @@index([lastSeenAt])
  @@map("worker_heartbeats")
}

// Milestone 2 — Identity, Organizations, and Tenancy

enum MembershipRole {
  OWNER
  DEVELOPER
  VIEWER

  @@map("membership_role")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String?  @db.VarChar(255)
  displayName String?  @map("display_name") @db.VarChar(255)
  avatarUrl   String?  @map("avatar_url") @db.VarChar(1024)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  externalIdentities   ExternalIdentity[]
  sessions             Session[]
  memberships          Membership[]
  createdOrganizations Organization[]     @relation("OrganizationCreator")
  createdApiKeys       ApiKey[]           @relation("ApiKeyCreator")

  @@map("users")
}

model ExternalIdentity {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  provider         String   @db.VarChar(32)
  providerUserId   String   @map("provider_user_id") @db.VarChar(255)
  providerUsername String?  @map("provider_username") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("external_identities")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model OAuthState {
  id           String   @id @default(uuid()) @db.Uuid
  state        String   @unique @db.VarChar(128)
  codeVerifier String   @map("code_verifier") @db.VarChar(128)
  redirectUri  String?  @map("redirect_uri") @db.VarChar(512)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("oauth_states")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(128)
  slug      String   @unique @db.VarChar(128)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator        User?           @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  memberships    Membership[]
  apiKeys        ApiKey[]
  endpoints      Endpoint[]
  destinations   Destination[]
  events         Event[]
  outboxMessages OutboxMessage[]
  deliveryAttempts DeliveryAttempt[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("org_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("memberships")
}

// Milestone 3 — API Keys and Ingestion

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("org_id") @db.Uuid
  name           String    @db.VarChar(128)
  keyPrefix      String    @map("key_prefix") @db.VarChar(16)
  keyHash        String    @unique @map("key_hash") @db.VarChar(64)
  scopes         String[]  @default(["ingest"]) @map("scopes")
  createdBy      String?   @map("created_by") @db.Uuid
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?        @relation("ApiKeyCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, revokedAt])
  @@map("api_keys")
}

// Milestone 3 Phase 2 & 3: Ingestion Endpoints, Events & Transactional Outbox

model Endpoint {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("org_id") @db.Uuid
  name             String   @db.VarChar(128)
  slug             String   @db.VarChar(128)
  secretCiphertext String   @map("secret_ciphertext") @db.Text
  secretIv         String   @map("secret_iv") @db.VarChar(32)
  secretTag        String   @map("secret_tag") @db.VarChar(32)
  secretPreview    String   @map("secret_preview") @db.VarChar(16)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("endpoints")
}

enum EventStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED

  @@map("event_status")
}

model Event {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("org_id") @db.Uuid
  endpointId     String      @map("endpoint_id") @db.Uuid
  idempotencyKey String?     @map("idempotency_key") @db.VarChar(255)
  eventType      String      @map("event_type") @db.VarChar(128)
  payload        Json        @map("payload")
  headers        Json?       @map("headers")
  status         EventStatus @default(RECEIVED) @map("status")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint       Endpoint        @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  outboxMessages OutboxMessage[]
  deliveryAttempts DeliveryAttempt[]

  @@unique([endpointId, idempotencyKey])
  @@index([organizationId])
  @@index([endpointId])
  @@index([createdAt])
  @@map("events")
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
  DEAD_LETTER

  @@map("outbox_status")
}

model OutboxMessage {
  id             String       @id @default(uuid()) @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  organizationId String       @map("org_id") @db.Uuid
  channel        String       @default("events") @db.VarChar(64)
  payload        Json         @map("payload")
  status         OutboxStatus @default(PENDING) @map("status")
  attemptCount   Int          @default(0) @map("attempt_count")
  maxRetries     Int          @default(5) @map("max_retries")
  nextRetryAt    DateTime?    @map("next_retry_at") @db.Timestamptz(3)
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  dispatchedAt   DateTime?    @map("dispatched_at") @db.Timestamptz(3)

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryAttempts DeliveryAttempt[]

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@index([leaseExpiresAt])
  @@index([organizationId])
  @@map("outbox_messages")
}

// Milestone 3 Option 1: Destination Registry & SSRF Protection

model Destination {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("org_id") @db.Uuid
  name               String   @db.VarChar(128)
  url                String   @db.VarChar(2048)
  httpMethod         String   @default("POST") @map("http_method") @db.VarChar(16)
  headers            Json?    @map("headers")
  rateLimitPerSecond Int      @default(50) @map("rate_limit_per_second")
  timeoutMs          Int      @default(10000) @map("timeout_ms")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryAttempts DeliveryAttempt[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("destinations")
}

// Milestone 3 Option 2: Durable HTTP Delivery Pipeline & Execution Attempts

enum DeliveryStatus {
  SUCCESS
  FAILED

  @@map("delivery_status")
}

model DeliveryAttempt {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @map("org_id") @db.Uuid
  eventId             String         @map("event_id") @db.Uuid
  destinationId       String         @map("destination_id") @db.Uuid
  outboxMessageId     String?        @map("outbox_message_id") @db.Uuid
  attemptNumber       Int            @default(1) @map("attempt_number")
  status              DeliveryStatus @map("status")
  statusCode          Int?           @map("status_code")
  latencyMs           Int            @map("latency_ms")
  requestUrl          String         @map("request_url") @db.VarChar(2048)
  requestMethod       String         @default("POST") @map("request_method") @db.VarChar(16)
  requestHeaders      Json?          @map("request_headers")
  responseHeaders     Json?          @map("response_headers")
  responseBodyPreview String?        @map("response_body_preview") @db.Text
  errorDescription    String?        @map("error_description") @db.Text
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  destination   Destination    @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  outboxMessage OutboxMessage? @relation(fields: [outboxMessageId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([eventId])
  @@index([destinationId])
  @@index([createdAt])
  @@map("delivery_attempts")
}
