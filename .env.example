# Local development credentials only. Containers use their private network names.
NODE_ENV=development
APP_VERSION=0.1.0
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
DATABASE_URL=postgresql://relayforge_api:relayforge_api_local@127.0.0.1:55432/relayforge
WORKER_DATABASE_URL=postgresql://relayforge_worker:relayforge_worker_local@127.0.0.1:55432/relayforge
MIGRATION_DATABASE_URL=postgresql://relayforge_admin:relayforge_admin_local@127.0.0.1:55432/relayforge
REDIS_URL=redis://127.0.0.1:56379/0
DATABASE_POOL_SIZE=5
DATABASE_TIMEOUT_MS=2000
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_MS=10000
QUEUE_PREFIX=relayforge
