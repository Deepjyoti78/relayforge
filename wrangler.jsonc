{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relayforge",
  "compatibility_date": "2026-11-19",
  "main": "./web/worker.js",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/auth", "/auth/*", "/v1", "/v1/*", "/health", "/health/*"],
    "not_found_handling": "single-page-application"
  }
}
