# A separate Compose project/database; integration tests never reset development data.
NODE_ENV=test
LOG_LEVEL=silent
DATABASE_URL=postgresql://relayforge_api:relayforge_api_local@127.0.0.1:55433/relayforge_test
WORKER_DATABASE_URL=postgresql://relayforge_worker:relayforge_worker_local@127.0.0.1:55433/relayforge_test
MIGRATION_DATABASE_URL=postgresql://relayforge_admin:relayforge_admin_local@127.0.0.1:55433/relayforge_test
REDIS_URL=redis://127.0.0.1:56380/0
DATABASE_TIMEOUT_MS=2000
QUEUE_PREFIX=relayforge-test
GITHUB_CLIENT_ID=gh_placeholder_client_id
GITHUB_CLIENT_SECRET=gh_placeholder_client_secret
GITHUB_CALLBACK_URL=http://127.0.0.1:3100/auth/github/callback
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_NAME=rf_session

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
