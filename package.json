{
  "name": "relayforge",
  "version": "0.1.0",
  "private": true,
  "description": "Reliable webhook delivery and bounded workflow orchestration",
  "engines": {
    "node": "^22.20.0 || ^24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "dev:api": "node --watch -r ts-node/register src/api/main.ts",
    "dev:worker": "node --watch -r ts-node/register src/worker/main.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix web run build",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "infra:up": "docker compose up -d --wait postgres redis",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile app up -d --build --wait",
    "stack:down": "docker compose --profile app down",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:smoke": "node scripts/smoke.cjs",
    "benchmark:receiver": "node benchmarks/receiver.cjs",
    "benchmark:run": "node benchmarks/run-benchmarks.cjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:backup": "node scripts/backup-db.cjs",
    "db:restore": "node scripts/restore-db.cjs",
    "healthcheck:worker": "node -r ts-node/register src/worker/healthcheck.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.7.2",
    "dotenv": "18.0.9",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "autocannon": "9.0.0",
    "eslint": "10.14.0",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  }
}
