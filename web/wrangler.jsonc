{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relayforge",
  "compatibility_date": "2026-11-19",
  "main": "./worker.js",
  "vars": {
    "FRONTEND_URL": "https://relayforge.deepmuse.workers.dev",
    "API_ORIGIN": "https://relayforge-staging-api.onrender.com"
  },
  "previews": {
    "vars": {
      "FRONTEND_URL": "https://preview.invalid",
      "API_ORIGIN": "https://preview-api.invalid",
      "PREVIEW_ONLY": "true"
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/auth", "/auth/*", "/v1", "/v1/*", "/health", "/health/*"],
    "not_found_handling": "single-page-application"
  }
}
