# RelayForge Production Environment Configuration Template
# COPY THIS FILE TO .env.production AND FILL IN SECURE VALUES
# NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL

NODE_ENV=production
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# DATABASE CONNECTIONS (Least-Privilege Roles & SSL Required)
# ------------------------------------------------------------------------------
# API Process Database URL (Connects as relayforge_api with RLS enforced)
DATABASE_URL=postgresql://relayforge_api:CHANGE_ME_STRONG_PASSWORD@your-db-host.internal:5432/relayforge_production?sslmode=require

# Worker Process Database URL (Connects as relayforge_worker with outbox lease capabilities)
WORKER_DATABASE_URL=postgresql://relayforge_worker:CHANGE_ME_STRONG_PASSWORD@your-db-host.internal:5432/relayforge_production?sslmode=require

# Connection Pool & Timeout Hardening
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_MS=3000

# ------------------------------------------------------------------------------
# DISTRIBUTED REDIS CACHE & RATE LIMITING
# ------------------------------------------------------------------------------
# Rediss (TLS) is mandatory for hosted environments
REDIS_URL=rediss://default:CHANGE_ME_STRONG_REDIS_AUTH@your-redis-host.internal:6380/0
QUEUE_PREFIX=relayforge_prod

# ------------------------------------------------------------------------------
# WORKER TUNING & HEARTBEAT LEASING
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_MS=10000

# ------------------------------------------------------------------------------
# ENCRYPTION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Must be at least 32 characters of high-entropy key material
ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_HEX_64_CHAR_KEY_DO_NOT_USE_DEFAULT

# SSRF Protection: MUST BE FALSE IN PRODUCTION
ALLOW_PRIVATE_DESTINATIONS=false

# ------------------------------------------------------------------------------
# AUTHENTICATION & GITHUB OAUTH 2.0
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=CHANGE_ME_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=CHANGE_ME_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=https://api.yourdomain.com/auth/github/callback
FRONTEND_URL=https://app.yourdomain.com
SESSION_COOKIE_NAME=rf_prod_session
